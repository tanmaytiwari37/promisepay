# Frontend Environment Variables
# Copy this file to .env.local for local overrides (NOT committed to git)
# Get Firebase values from: Firebase Console > Project Settings > Your Apps > Web App

# Firebase Configuration (required for Google Sign-In)
# Set these to enable "Sign in with Google" button
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# API Base URL
# Local: http://localhost:8000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000