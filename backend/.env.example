# Backend environment variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./promisepay.db

# JWT Authentication
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM (AI) Configuration
LLM_PROVIDER=mock  # mock | gemini | openai_compatible
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=  # for openai_compatible (e.g., NVIDIA NIM)

# PayPal Configuration
PAYPAL_MODE=mock  # mock | sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Upload directory
UPLOAD_DIR=uploads

# Firebase project ID (public value), used to verify Google sign-in tokens
FIREBASE_PROJECT_ID=